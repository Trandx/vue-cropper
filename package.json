{
  "name": "@trandx/vue-cropper",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "module": "dist/lib/index.js",
  "types": "dist/types/index.d.ts",
  "style": "dist/lib/index.css",
  "exports": {
    ".": {
      "import": "./dist/lib/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./css": {
      "import": "./dist/lib/index.css"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && npm run cp && npm run mv-pkg-json",
    "preview": "vite preview",
    "cp": "find ./ -maxdepth 1 -type f \\( -name 'pub.*.json' -o -name 'README.md' \\) -exec cp {} ./dist \\; ",
    "mv-pkg-json": "cd ./dist && mv pub.package.json package.json"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": true,
          "pkgRoot": "dist",
          "access": "public",
          "tag": "latest"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vue-tsc": "^2.2.2"
  }
}